# Copy to .env.production and fill in. NEVER commit the real file.
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# ---- Your domain (DNS A/AAAA record must already point at this server) ----
DOMAIN=app.example.co.ke
ACME_EMAIL=you@example.co.ke            # Let's Encrypt expiry notices

# ---- Secrets: generate each one, never reuse ----
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=
DB_NAME=getbyfarm
DB_USER=getbyfarm

# ---- M-Pesa (leave MPESA_ENABLED=false until you've completed the sandbox + go-live checklist) ----
MPESA_ENABLED=false
MPESA_ENV=sandbox                        # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for a Till
MPESA_PARTY_B=                           # Till number if using a Till; blank = shortcode
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MPESA_CALLBACK_SECRET=
# Safaricom's published callback IP ranges (space-separated CIDRs). Blank = allow any source.
MPESA_ALLOWED_IPS=

# ---- Optional: restrict /django-admin/ to these CIDRs (space-separated), e.g. your office or VPN ----
ADMIN_ALLOWED_IPS=

# ---- Staging/demo ONLY: fake payments that charge nobody. Never on a real production site. ----
ALLOW_MOCK_PAYMENTS=false
I_UNDERSTAND_MOCK_PAYMENTS_ARE_FAKE=false
