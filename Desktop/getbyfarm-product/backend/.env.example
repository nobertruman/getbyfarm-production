# Local development only (docker-compose.prod.yml sets these for production).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-not-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Either a URL...
# DATABASE_URL=postgresql://getbyfarm:password@localhost:5432/getbyfarm
# ...or discrete values:
DB_NAME=getbyfarm
DB_USER=getbyfarm
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOW_MOCK_PAYMENTS=true      # dev convenience: payments succeed instantly, charging nobody
