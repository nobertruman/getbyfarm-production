{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# 'unsafe-inline' is required today by Next.js hydration scripts and Django admin. Moving to
		# nonce-based CSP is a worthwhile follow-up hardening step.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Only Safaricom should call the M-Pesa callback. Set MPESA_ALLOWED_IPS to Safaricom's current
	# published ranges for your environment (see docs/DEPLOYMENT.md). Default allows all; the secret
	# in the URL and payment matching still apply.
	@mpesa_blocked {
		path /api/payments/mpesa-callback/*
		not remote_ip {$MPESA_ALLOWED_IPS:0.0.0.0/0 ::/0}
	}
	# NOTE: these must be `handle` blocks written BEFORE the catch-all handles. Caddy runs `handle` ahead of
	# a bare `respond`, so a plain `respond @blocked` here would silently never fire.
	handle @mpesa_blocked {
		respond "Forbidden" 403
	}

	# Optionally lock the Django admin console to your office/VPN addresses.
	@admin_blocked {
		path /django-admin/*
		not remote_ip {$ADMIN_ALLOWED_IPS:0.0.0.0/0 ::/0}
	}
	handle @admin_blocked {
		respond "Forbidden" 403
	}

	@backend path /api/* /django-admin/* /static/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
